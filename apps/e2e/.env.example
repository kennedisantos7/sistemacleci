# Copie para .env (o .env está no .gitignore — nunca versione credencial).

# Alvo dos testes. Padrão do config é http://localhost:3001 (ambiente local).
# Contra produção, rode SÓ a fatia @smoke: pnpm test:smoke
BASE_URL="http://localhost:3001"

# Senha única das contas de teste criadas pelo seed E2E (mín. 8 caracteres).
# São contas descartáveis num banco descartável — não reaproveite senha real.
TEST_PASSWORD=""
